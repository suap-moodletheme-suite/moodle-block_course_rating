 <div class="row ps-3">
        <div class="col-12 col-sm-3 col-lg-2 text-center text-sm-end">
            <h1 class="rating_title">
                {{rating_total}}
            </h1>
        </div>
        <div class="col-12 col-sm-9 col-lg-10 me-n3 text-center text-sm-start">
            {{{rating_stars}}}
            <br/>
            <p class="pt-1 text_rating d-block">
                {{rating_text_votes}}
            </p>
        </div>
    </div>
    <!-- Rating Percents -->
    <div class="row ps-3 mb-3">
        <div class="col-12 col-sm-5 col-md-5 col-lg-4 col-xl-3 ps-md-5 ps-sm-3 me-n3">
            {{{stars_percents}}}
        </div>
        <div class="col-6 col-sm-7 col-md-7 col-lg-8 col-xl-9 ms-sm-n5 ms-n5 d-none d-sm-block">
        {{{stars_bars}}}
        </div>
    </div>